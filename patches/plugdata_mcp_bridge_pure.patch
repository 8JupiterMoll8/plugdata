+                            kind = "msg";
+                            type = "msg";
+                        } else if (textObj->te_type == T_ATOM) {
+                            kind = (className.containsIgnoreCase("symbol") ? "symbolatom" : "floatatom");
+                            type = kind;
+                        } else if (textObj->te_type == T_TEXT) {
