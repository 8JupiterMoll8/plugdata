+                    String objectText;
+                    if (kind == "msg") {
+                        if (!tokens.isEmpty() && tokens[0] == "msg") tokens.remove(0);
+                        objectText = "msg " + tokens.joinIntoString(" ");
+                    } else if (kind == "text" || kind == "comment") {
+                        if (!tokens.isEmpty() && (tokens[0] == "text" || tokens[0] == "comment")) tokens.remove(0);
