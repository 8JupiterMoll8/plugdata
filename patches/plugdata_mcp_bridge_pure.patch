+    case hash("mcp_disconnect_batch_id"): {
+        if (list.size() >= 2) {
+            auto canvas_symbol = list[0].toString();
+            auto correlation_id = list[1].toString();
+
+            int disconnectedCount = 0;
+            sys_lock();
