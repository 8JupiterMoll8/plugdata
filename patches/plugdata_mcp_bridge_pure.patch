+            sys_unlock();
+
+            SmallArray<pd::Atom> atoms;
+            atoms.add(pd::Atom(success ? 1.0f : 0.0f));
+            sendMCPReply(String("/pd/mcp_create_id/reply/" + correlation_id), atoms);
