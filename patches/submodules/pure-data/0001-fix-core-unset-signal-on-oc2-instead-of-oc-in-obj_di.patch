From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alphi <alphi@starchaser.local>
Date: Fri, 4 Sep 2026 10:25:22 +0200
Subject: [PATCH 1/2] fix(core): unset signal on oc2 instead of oc in
 obj_disconnect to prevent dangling weak reference heap corruption

---
 src/m_obj.c | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/src/m_obj.c b/src/m_obj.c
index ebd23dc..3e6d3f4 100644
--- a/src/m_obj.c
+++ b/src/m_obj.c
@@ -27,6 +27,9 @@ int is_reference_valid(void* ptr);
 int plugdata_debugging_or_activity_enabled();
 void signal_makereusable(t_signal *sig);
 
+/* MCP hot-patching: when > 0, defer per-wire canvas_update_dsp() calls */
+int dsp_update_deferred = 0;
+
 union inletunion
 {
     t_symbol *iu_symto;
@@ -730,7 +733,7 @@ doit:
         oc2->oc_next = oc;
     }
     else *ochead = oc;
-    if (o->o_sym == &s_signal) canvas_update_dsp();
+    if (o->o_sym == &s_signal && !dsp_update_deferred) canvas_update_dsp();
 
     return (oc);
 }
@@ -774,7 +777,7 @@ doit:
         {
             oc->oc_next = oc2->oc_next;
             if(oc2->oc_signal)  {
-                outconnect_unset_signal(oc);
+                outconnect_unset_signal(oc2);
             }
             freebytes(oc2, sizeof(*oc2));
             goto done;
@@ -782,7 +785,7 @@ doit:
         oc = oc2;
     }
 done:
-    if (o->o_sym == &s_signal) canvas_update_dsp();
+    if (o->o_sym == &s_signal && !dsp_update_deferred) canvas_update_dsp();
 }
 
 /* ------ traversal routines for code that can't see our structures ------ */
