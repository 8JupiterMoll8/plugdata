From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alphi <alphi@starchaser.local>
Date: Fri, 4 Sep 2026 10:25:22 +0200
Subject: [PATCH 2/3] feat(core): add dsp_update_deferred to batch
 canvas_update_dsp calls

Adds the global `int dsp_update_deferred` (m_obj.c). While it is above zero,
obj_connect and obj_disconnect on a signal outlet skip their per-wire
canvas_update_dsp(). Without it a batch of N signal wires recompiles the DSP
graph N times, which dropped audio.

Depended on by: the bridge's batch_atomic, which sets it to 1 before its
create/connect/delete phases and back to 0 afterwards, then recompiles once
(MCPBridge.cpp, `extern int dsp_update_deferred`). Dropping this patch breaks
the link of plugdata_core. It is a feature, not a bug fix, and has no
upstream equivalent.
---
 src/m_obj.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/src/m_obj.c b/src/m_obj.c
index 97b9bd7..3e6d3f4 100644
--- a/src/m_obj.c
+++ b/src/m_obj.c
@@ -27,6 +27,9 @@ int is_reference_valid(void* ptr);
 int plugdata_debugging_or_activity_enabled();
 void signal_makereusable(t_signal *sig);
 
+/* MCP hot-patching: when > 0, defer per-wire canvas_update_dsp() calls */
+int dsp_update_deferred = 0;
+
 union inletunion
 {
     t_symbol *iu_symto;
@@ -730,7 +733,7 @@ doit:
         oc2->oc_next = oc;
     }
     else *ochead = oc;
-    if (o->o_sym == &s_signal) canvas_update_dsp();
+    if (o->o_sym == &s_signal && !dsp_update_deferred) canvas_update_dsp();
 
     return (oc);
 }
@@ -782,7 +785,7 @@ doit:
         oc = oc2;
     }
 done:
-    if (o->o_sym == &s_signal) canvas_update_dsp();
+    if (o->o_sym == &s_signal && !dsp_update_deferred) canvas_update_dsp();
 }
 
 /* ------ traversal routines for code that can't see our structures ------ */
