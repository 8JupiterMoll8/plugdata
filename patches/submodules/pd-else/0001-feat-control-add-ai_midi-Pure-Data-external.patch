diff --git a/Source/Control/ai_midi.c b/Source/Control/ai_midi.c
new file mode 100644
index 000000000..61e91f378
--- /dev/null
+++ b/Source/Control/ai_midi.c
@@ -0,0 +1,316 @@
+// ai_midi.c - Interactive AI MIDI Cassette object for Pure Data & PlugData
+// Copyright (c) 2026 Timothy Schoen & Jupiter Moll
