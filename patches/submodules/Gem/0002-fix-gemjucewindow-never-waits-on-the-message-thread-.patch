+        if (auto* target = targetWindow()) {
             juce::MessageManager::callAsync(
-                [safeWindow = juce::Component::SafePointer<Window>(m_window),
+                [safeWindow = juce::Component::SafePointer<Window>(target),
                  w = (int)width, h = (int)height] {
