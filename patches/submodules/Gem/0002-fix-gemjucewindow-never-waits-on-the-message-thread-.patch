     // ── Desktop window state ─────────────────────────────────────────────
 
     Window* m_window = nullptr;
-    std::atomic<bool> m_resizing = false;
-    bool m_callingSync = false;
+    // The Pd instance this object was created in (9): the thread that later sends create may
+    // never have selected one (e.g. a bridge worker), so libpd_this_instance() is not used there.
+    t_pdinstance* m_pdInstance = libpd_this_instance();
+
+    // Deferred creation. create() runs inside a Pd message (Pd lock held), so it must not wait
+    // for the message thread: it posts the window construction there and returns. The message
+    // thread builds the Window under the Pd lock and parks it in m_pendingWindow; m_createClock
+    // (a Pd clock, so again under the Pd lock) then finishes the GL setup on the Pd thread.
+    // Every field below is only touched with the Pd lock held.
+    struct CreateTicket
+    {
+        std::atomic<bool> alive { true };  // false once this object is being freed (read before any Pd call)
+        std::atomic<int> generation { 0 }; // bumped by destroy/free: a posted construction that no longer matches is dropped
+    };
+    std::shared_ptr<CreateTicket> m_ticket = std::make_shared<CreateTicket>();
+    bool m_createPending = false;
+    Window* m_pendingWindow = nullptr;
+    t_clock* m_createClock = nullptr;
+
+    static void createClockCallback(gemjucewindow* x) { x->pollPendingWindow(); }
+
+    void pollPendingWindow()
+    {
+        if (!m_createPending)
+            return;
+        if (!m_pendingWindow) {
+            clock_delay(m_createClock, 5);
+            return;
+        }
+        m_window = m_pendingWindow;
+        m_pendingWindow = nullptr;
+        m_createPending = false;
+        finishCreate();
+    }
+
+    // The window may still have queued callbacks: cut it loose now (Pd lock held), delete it
+    // later on the message thread, never wait for that.
+    static void deleteWindowLater(Window* win)
+    {
+        if (!win)
+            return;
+        win->detachOwner();
+        auto finish = [safe = juce::Component::SafePointer<Window>(win)] {
+            if (auto* w = safe.getComponent()) {
+                w->glContext().detach();
+                w->removeFromDesktop();
+                delete w;
+            }
+        };
+        if (juce::MessageManager::getInstance()->isThisTheMessageThread())
+            finish();
+        else
+            juce::MessageManager::callAsync(std::move(finish));
+    }
+
+    void cancelPendingCreate()
+    {
+        if (!m_createPending)
+            return;
+        m_createPending = false;
+        ++m_ticket->generation;
+        if (m_createClock)
+            clock_unset(m_createClock);
+        deleteWindowLater(m_pendingWindow);
+        m_pendingWindow = nullptr;
+    }
+
+    // The window that size/position messages should reach: the live one, or one still being set up.
+    Window* targetWindow() const { return m_window ? m_window : m_pendingWindow; }
+
 public:
 
     gemjucewindow(void)
     {
         m_width = m_height = 0;
+        m_createClock = clock_new(this, reinterpret_cast<t_method>(createClockCallback));
     }
 
     virtual ~gemjucewindow(void)
     {
+        m_ticket->alive = false;
         destroyMess();
+        if (m_createClock)
+            clock_free(m_createClock);
+        m_createClock = nullptr;
     }
 
