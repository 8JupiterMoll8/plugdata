-                [safeWindow = juce::Component::SafePointer<Window>(m_window), x, y] {
+                [safeWindow = juce::Component::SafePointer<Window>(target), x, y] {
                     if (safeWindow) safeWindow->setTopLeftPosition(x, y);
                 });
         }
     }
 
-    void callOnMessageThread(std::function<void()> callback)
+    Window* constructWindow()
     {
-        auto onMessageThread = juce::MessageManager::getInstance()->isThisTheMessageThread();
-        juce::ScopedValueSetter<bool> scopedSetter(m_callingSync, !onMessageThread);
-        juce::MessageManager::callSync([callback](){
-          callback();
-        });
+        // Message thread, Pd lock held: resized() (from setBounds) calls Gem directly.
+        juce::ScopedValueSetter<bool> scopedSetter(m_callingSync, true);
+        return new Window(
+            juce::Rectangle<int>(
+                m_xoffset, m_yoffset,
+                m_width  ? (int)m_width  : 500,
+                m_height ? (int)m_height : 500),
+            m_border != 0,
+            libpd_this_instance(),
+            this);
     }
 
     bool create(void) override
     {
-        if (m_window) { error("window already made!"); return false; }
+        if (m_window || m_createPending) { error("window already made!"); return false; }
 
-        callOnMessageThread([this](){
-          m_window = new Window(
-              juce::Rectangle<int>(
-                  m_xoffset, m_yoffset,
-                  m_width  ? (int)m_width  : 500,
-                  m_height ? (int)m_height : 500),
-              m_border != 0,
-              libpd_this_instance(),
-              this);
-        });
+        if (juce::MessageManager::getInstance()->isThisTheMessageThread()) {
+            m_window = constructWindow();
+            return finishCreate();
+        }
 
+        // Never wait for the message thread here (it may be waiting for the Pd lock we hold).
+        m_createPending = true;
+        juce::MessageManager::callAsync(
+            [this, ticket = m_ticket, generation = m_ticket->generation, instance = libpd_this_instance()] {
+                libpd_set_instance(instance);
+                sys_lock();
+                // Freed, destroyed or re-created since this was posted: drop it.
+                if (ticket->alive && ticket->generation == generation && m_createPending && !m_pendingWindow)
+                    m_pendingWindow = constructWindow();
+                sys_unlock();
+            });
+        clock_delay(m_createClock, 5);
+        return true;
+    }
+
+    // Pd thread, Pd lock held: the GL half of create().
+    bool finishCreate(void)
+    {
         if (!m_window) { error("JUCE couldn't create window"); return false; }
 
         if (!makeCurrent()) {
@@ -840,6 +949,7 @@ public:
 
     void destroyMess(void) override
     {
+        cancelPendingCreate(); // a destroy before the window exists: the queued construction is dropped
         if (!m_window) return;
 
         if (m_activeCanvas) {
@@ -853,11 +963,11 @@ public:
 
         Window* win = m_window;
         m_window = nullptr;
-        callOnMessageThread([win] {
-              win->glContext().detach();
-              win->removeFromDesktop();
-              delete win;
-        });
+        // We run inside a Pd message, so this thread holds the Pd lock. Waiting here for the
+        // message thread (callSync) deadlocks as soon as the message thread wants that lock
+        // (the window's own timer, a mouse event, any plugdata GUI update). So the window is
+        // cut loose under the lock now and deleted later on the message thread, without waiting.
+        deleteWindowLater(win);
         destroy();
     }
 
