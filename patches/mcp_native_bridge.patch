+            sendMCPReply(String("/pd/mcp_disconnect_batch_id/reply/" + correlation_id), atoms);
+            sendMessagesFromQueue();
+            enqueueFunctionAsync([this] { synchroniseCanvases(); });
+        }
+        break;
+    }
+    case hash("quit"):
+    case hash("verifyquit"): {
+        if (ProjectInfo::isStandalone) {
+            bool askToSave = hash(selector) == hash("verifyquit");
+            for (auto* editor : getEditors()) {
+                editor->quit(askToSave);
+            }
+        } else {
+            logWarning("Quitting Pd not supported in plugin");
+        }
+        break;
+    }
+    default: break;
+    }
+}
